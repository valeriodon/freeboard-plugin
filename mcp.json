{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "freeboard": {
      "type": "streamable-http",
      "url": "https://app.freeboard.money/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://app.freeboard.money/oauth/register",
            "baseScopes": [
              "bilancio"
            ]
          }
        }
      }
    }
  }
}
